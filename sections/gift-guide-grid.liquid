{% comment %}
  Gift Guide grid
  ---------------
  Custom section built from scratch for the test (no Dawn sections or snippets reused).

  Renders up to six product tiles. Each tile shows a product image with a round
  "+" hotspot whose position is set per block in the customizer. Clicking a
  hotspot opens a quick-view popup (one popup per section, reused for every
  product) that loads the product from the storefront product JSON and lets the
  shopper pick variants and add to cart.

  Companion rule: when the chosen variant matches the trigger colour and size
  (Black / M by default) a companion product (Soft Winter Jacket) is added to
  the cart as well. Handled in gift-guide-grid.js.
{% endcomment %}

{{ 'gift-guide-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-guide-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign popup_title_id = 'gg-popup-title-' | append: section.id
-%}

<section
  class="gg-grid-section"
  data-gg-grid
  data-money-format="{{ shop.money_format | escape }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-companion-handle="{{ s.companion_handle | escape }}"
  data-companion-color="{{ s.companion_color | escape }}"
  data-companion-size="{{ s.companion_size | escape }}"
>
  {%- if s.heading != blank -%}
    <h2 class="gg-grid__heading">{{ s.heading }}</h2>
  {%- endif -%}

  <div class="gg-grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <article class="gg-grid__item" {{ block.shopify_attributes }}>
        {%- if product != blank -%}
          {%- if block.settings.image != blank -%}
            {%- assign image = block.settings.image -%}
          {%- else -%}
            {%- assign image = product.featured_image -%}
          {%- endif -%}

          {%- assign image_alt = product.title -%}
          {%- if image != blank and image.alt != blank -%}
            {%- assign image_alt = image.alt -%}
          {%- endif -%}

          {%- if image != blank -%}
            {{
              image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1200',
                sizes: '(min-width: 750px) 33vw, 50vw',
                class: 'gg-grid__image',
                alt: image_alt
            }}
          {%- endif -%}

          <button
            type="button"
            class="gg-hotspot"
            style="left: {{ block.settings.hotspot_horizontal }}%; top: {{ block.settings.hotspot_vertical }}%;"
            data-gg-hotspot
            data-product-url="{{ product.url }}"
            aria-haspopup="dialog"
            aria-label="Quick view: {{ product.title | escape }}"
          >
            <span aria-hidden="true">+</span>
          </button>
        {%- else -%}
          <div class="gg-grid__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'gg-grid__placeholder-svg' }}
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>

  {%- comment -%} Quick-view popup, hidden until a hotspot is clicked {%- endcomment -%}
  <div class="gg-popup" data-gg-popup hidden>
    <div class="gg-popup__overlay" data-gg-popup-dismiss></div>

    <div
      class="gg-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ popup_title_id }}"
    >
      <button
        type="button"
        class="gg-popup__close"
        data-gg-popup-dismiss
        aria-label="Close"
      >
        &times;
      </button>

      <div class="gg-popup__body" data-gg-popup-body aria-live="polite">
        {%- comment -%} Contents injected by gift-guide-grid.js {%- endcomment -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide grid",
  "tag": "section",
  "class": "gg-grid-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" },
    { "type": "header", "content": "Companion product rule" },
    {
      "type": "paragraph",
      "content": "When a shopper adds a product whose selected colour and size match the values below, the companion product is added to the cart automatically."
    },
    { "type": "text", "id": "companion_handle", "label": "Companion product handle", "default": "dark-winter-jacket" },
    { "type": "text", "id": "companion_color", "label": "Trigger colour value", "default": "Black" },
    { "type": "text", "id": "companion_size", "label": "Trigger size value", "default": "M" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Defaults to the product's featured image."
        },
        {
          "type": "range",
          "id": "hotspot_horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Hotspot horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Hotspot vertical position",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gift Guide grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
